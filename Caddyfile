# Frontend-tjänstens statiska server (Railpack plockar upp en Caddyfile i projektroten
# och renderar den som Go-template; {{.DIST_DIR}} = /app/<RAILPACK_SPA_OUTPUT_DIR>).
# Backend-tjänsten berörs inte: den har ett eget startkommando och körs aldrig via Caddy.
# Utgår från Railpacks standardmall (core/providers/node/Caddyfile.template) med två tillägg:
#   1. index.html och SPA-routes får Cache-Control: no-cache, så en deploy aldrig fastnar
#      bakom en gammal cachad startsida som pekar på borttagna kodfiler.
#   2. Saknade filer under /assets ger 404 i stället för index.html (HTML som JS = vit sida).
#   3. Filmen under /media (RUN-257): versionerade filnamn (landing-film-720.v1.mp4) cachas för alltid, saknade filer ger 404, och mp4 komprimeras
#      inte (encode tar bara text, json, svg m.fl.; Range ger 206 av file_server). .webmanifest får sin typ explicit (RUN-205).
#   4. Källkartor (.map) ger alltid 404, på alla sökvägar även under /assets, /media och /fonts, också när filen finns (RUN-285). Reglerna ligger i ett route-block för att behålla källordningen.
#   5. Den förrenderade landningen (RUN-260, ADR 006 addendum 2026-10-19): EXAKT `/` (med valfri query) får landing.html, alla andra adresser index.html (vars #root bara har laddningsvyn).
#      Saknas landing.html faller `/` tillbaka på index.html. `/landing.html` och `/landing` omdirigeras till `/`, så landningen har en enda adress.
#   6. Säkerhetshuvuden (RUN-344): HSTS, Referrer-Policy, X-Frame-Options och CSP på alla svar (se header-blocket), och /vendor/* för Umamis tracker (samma mönster som /fonts).
# Beteendet verifieras i CI mot det byggda dist/ (scripts/verify-static-serving.sh).

{
	admin off
	persist_config off
	auto_https off

	log {
		format json
	}

	servers {
		trusted_proxies static private_ranges 100.0.0.0/8
	}
}

:{$PORT:80} {
	log {
		format json
	}

	# Appen har EN adress: www.runquest.dev. API:ets CORS tillåter bara den, och inloggningen
	# (localStorage) är per adress — därför skickas apex-domänen vidare i stället för att servera appen.
	@apex host runquest.dev
	redir @apex https://www.runquest.dev{uri} 308

	# Egen handle: ett toppnivå-respond sorteras efter handle och skulle skuggas av SPA-blocket.
	handle /health {
		respond 200
	}

	# Säkerhetshuvuden (RUN-344) på ALLA svar, också 404, omdirigeringar och /health (header körs före handle/route). Samma Caddyfile i prod och staging.
	#   - HSTS: ett år, utan includeSubDomains och utan preload. Underdomänerna är inte inventerade, och preload går inte att ångra snabbt (docs/release.md, "Säkerhetshuvuden").
	#   - X-Frame-Options: DENY gäller skarpt även medan CSP går som Report-Only (frame-ancestors i en Report-Only-policy blockerar inget). Båda finns kvar när CSP blir skarp.
	#   - CSP: vakten scripts/csp-hashes.mjs (körs av verify-static-serving.sh) fäller bygget om en inline-hash här inte längre stämmer med dist.
	#     script-src: 'self' + hashar för de fyra inline-skripten (index.html: laddarens fas; landing.html: sessionstips och next-themes; strava-popup.html: OAuth-återkopplingen). Ingen
	#       unsafe-inline, unsafe-eval eller strict-dynamic (landningens boot-skript lägger in modulskript och modulepreload från samma ursprung, 'self' räcker).
	#     style-src: 'self' 'unsafe-inline', inga hashar. Det går inte att fästa stilarna: react-remove-scroll (Radix-dialogerna) lägger in en <style> vars text bär uppmätta marginaler och
	#       scrollistens bredd, sonner lägger in sin CSS som <style> vid import, <noscript><style> i index.html och 28 style-attribut i den förrenderade markupen (landning och laddare) läses före hydrering.
	#       Hashar hade blockerat dialoger och toasts (provat i Report-Only mot e2e-sviten). En inline-stil kan inte köra skript; det som återstår (CSS som läcker via attributväljare) begränsas
	#       av img-src, font-src och connect-src. csp-hashes.mjs prövar att style-src är exakt det här, så en ändring blir ett medvetet val.
	#     connect-src: API:erna för prod och staging (båda listas så att filen är densamma), Sentry EU-ingest (bara inloggade skalet, mönster eftersom DSN-värdet inte läses) och Umamis tracker-endpoint
	#       (spårskriptet ligger i public/vendor/ och pekas dit med data-host-url, se umamiPageviews.ts). Umami-skriptet kommer från 'self' och behöver ingen plats i script-src.
	#     img-src: Supabase Storage (profilbilder) för prod- och stagingprojektet. font-src/media-src/manifest-src: bara 'self' (typsnitt, film och manifest är självhostade).
	#     frame-ancestors, object-src, base-uri och form-action låses; inget formulär postar dokumentet, inloggning och väntelista går via fetch till API:et (connect-src).
	# Ingen report-uri/report-to: den skulle kräva Sentrys DSN-nyckel. Överträdelser samlas i e2e-proven (apps/e2e/support/cspViolations.ts).
	header {
		X-Content-Type-Options "nosniff"
		Strict-Transport-Security "max-age=31536000"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "DENY"
		Content-Security-Policy "default-src 'self'; script-src 'self' 'sha256-1yYJuvj582gVqQR/dSkeTdHfAS0wEZ/XUOH2vBttgR4=' 'sha256-ZOYfxyHFjZ5/ZypzQqo7o6mVTAHx2LSg5JpFHQYE7bQ=' 'sha256-y6TTgelvIX7DWIP0PdL2CA4Hx4x30cz3z0XnqmSNwpw=' 'sha256-ENgRl/chRPaOunHsdSJWIrmZCfT35J163c/mCMMs+kQ='; style-src 'self' 'unsafe-inline'; img-src 'self' https://yrrqaxdngayakcivfrck.supabase.co https://aormctqrmguvncxrigwy.supabase.co; font-src 'self'; media-src 'self'; manifest-src 'self'; connect-src 'self' https://api.runquest.dev https://runquest-backend-staging-staging.up.railway.app https://*.ingest.de.sentry.io https://gateway.umami.is; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		-Server
	}

	root * {{.DIST_DIR}}

	encode {
		gzip
		zstd
	}

	# Alla handle-block ligger i ETT route-block (RUN-285). Utan route sorterar Caddyfile-adaptern handle-block med samma direktiv efter
	# path-matcherns längd, längst först: `*.map` (5 tecken) hamnade då EFTER /assets/*, /media/* och /fonts/*, och en .map som låg kvar där
	# serverades med immutable. route behåller källordningen, så .map-regeln prövas före alla andra block. Header, root och encode ligger utanför
	# och gäller alla svar.
	# Källkartor (.map) är till för Sentry och serveras aldrig, på någon sökväg. Bygget tar bort dem ur dist; den här regeln gör att en som ändå
	# råkar ligga kvar inte nås (inte heller under /assets, /media eller /fonts), och att en förfrågan som /foo.js.map får 404 i stället för
	# index.html via SPA-fallbacken.
	route {
		@sourcemap path *.map
		handle @sourcemap {
			header Cache-Control "no-store"
			respond "Not found" 404
		}

		# Landningens filadresser: SPA-blockets try_files löser både /landing.html och /landing till landing.html. De skickas till / med frågan kvar (307, inte permanent: ingen
		# webbläsare ska cacha omdirigeringen om adressen en dag får ett eget innehåll). Lean routern klarar dem också (landingAddress.ts), men då som en andra adress till samma sida.
		# Två matchare, så att en adress utan fråga inte får ett lösryckt "?" (Caddy har ingen placeholder för frågan med sitt "?").
		@landingfileq {
			path /landing /landing.html
			expression `{query} != ""`
		}
		redir @landingfileq /?{query} 307
		@landingfile path /landing /landing.html
		redir @landingfile / 307

		# Förrenderad landning på exakt / (frågesträngen ignoreras, så /?utm_source=… och gamla /?tab=… får också landningen). Sökvägen jämförs som den kom
		# (placeholdern {http.request.uri.path}), inte med path-matcharen: den slår ihop snedstreck och rensar punktsegment, så "path /" matchade också //, ///, /./ och /%2f.
		# De fick då landing.html, och lean routern (landingAddress.ts) kastade på dem och lämnade sidan vit. Nu faller de på SPA-blocket och får index.html som före S6.
		# `file` gör att ett bygge utan landing.html faller tillbaka på SPA-blocket nedan i stället för att ge 404. no-cache som för index.html: en deploy ska aldrig
		# fastna bakom en gammal fil som pekar på borttagna kodfiler. encode gäller som för övriga svar.
		@landing {
			expression `{http.request.uri.path} == "/"`
			file /landing.html
		}
		handle @landing {
			header Cache-Control "no-cache"
			rewrite * /landing.html
			file_server {
				hide .git
				hide .env*
			}
		}

		# Vite-hashade filer byter namn vid varje bygge och får cachas för alltid.
		# Cache-headern sätts bara på filer som finns: en cachad 404 skulle överleva nästa deploy.
		handle /assets/* {
			@exists {
				file
				not path */
			}
			header @exists Cache-Control "public, max-age=31536000, immutable"
			@missing not {
				file
				not path */
			}
			header @missing Cache-Control "no-store"
			respond @missing "Not found" 404
			file_server
		}

		# Filmens mediefiler: namnet bär versionen (.v1), så en ändrad fil får ett nytt namn och cachen kan vara för alltid. Samma mönster som /assets.
		handle /media/* {
			@exists {
				file
				not path */
			}
			header @exists Cache-Control "public, max-age=31536000, immutable"
			@missing not {
				file
				not path */
			}
			header @missing Cache-Control "no-store"
			respond @missing "Not found" 404
			file_server
		}

		# Självhostade typsnitt (OFL, se public/fonts/OFL.txt): namnet bär versionen (bebas-neue-400.v1.woff2), så filerna cachas för alltid. Saknade filer ger 404, aldrig index.html (HTML som typsnitt = tyst reservtypsnitt).
		# Typen sätts explicit eftersom typtabellen i prodcontainern är okänd; file_server skriver bara över Content-Type när den saknas. CSP:ns font-src är 'self'.
		handle /fonts/* {
			@exists {
				file
				not path */
			}
			header @exists Cache-Control "public, max-age=31536000, immutable"
			@woff2 {
				file
				path *.woff2
			}
			header @woff2 Content-Type "font/woff2"
			@missing not {
				file
				not path */
			}
			header @missing Cache-Control "no-store"
			respond @missing "Not found" 404
			file_server
		}

		# Tredjepartsfiler vi hostar själva (public/vendor, RUN-344): Umamis tracker. Namnet bär versionen (umami.v1.js), så filen cachas för alltid; en saknad fil ger 404, aldrig index.html
		# (HTML som skript = tyst stoppad statistik). Skriptet laddas same-origin och släpps in av script-src 'self'.
		handle /vendor/* {
			@exists {
				file
				not path */
			}
			header @exists Cache-Control "public, max-age=31536000, immutable"
			@missing not {
				file
				not path */
			}
			header @missing Cache-Control "no-store"
			respond @missing "Not found" 404
			file_server
		}

		# Go och Caddy saknar .webmanifest i sin inbyggda typtabell, och typtabellen i prodcontainern är okänd: typen sätts explicit.
		# file_server skriver bara över Content-Type när den saknas, så den här gäller. Bara om filen finns: en saknad manifestfil faller tillbaka på index.html och ska inte få manifesttypen.
		@webmanifest {
			path /site.webmanifest
			file
		}
		header @webmanifest Content-Type "application/manifest+json"

		handle {
			header Cache-Control "no-cache"
			try_files {path} {path}.html {path}/index.html /index.html
			file_server {
				hide .git
				hide .env*
			}
		}
	}
}
