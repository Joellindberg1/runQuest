# Frontend-tjänstens statiska server (Railpack plockar upp en Caddyfile i projektroten
# och renderar den som Go-template; {{.DIST_DIR}} = /app/<RAILPACK_SPA_OUTPUT_DIR>).
# Backend-tjänsten berörs inte: den har ett eget startkommando och körs aldrig via Caddy.
# Utgår från Railpacks standardmall (core/providers/node/Caddyfile.template) med två tillägg:
#   1. index.html och SPA-routes får Cache-Control: no-cache, så en deploy aldrig fastnar
#      bakom en gammal cachad startsida som pekar på borttagna kodfiler.
#   2. Saknade filer under /assets ger 404 i stället för index.html (HTML som JS = vit sida).
#   3. Filmen under /media (RUN-257): versionerade filnamn (landing-film-720.v1.mp4) cachas för alltid, saknade filer ger 404, och mp4 komprimeras
#      inte (encode tar bara text, json, svg m.fl.; Range ger 206 av file_server). .webmanifest får sin typ explicit (RUN-205).
#   4. Källkartor (.map) ger alltid 404, på alla sökvägar (RUN-285).
# Beteendet verifieras i CI mot det byggda dist/ (scripts/verify-static-serving.sh).

{
	admin off
	persist_config off
	auto_https off

	log {
		format json
	}

	servers {
		trusted_proxies static private_ranges 100.0.0.0/8
	}
}

:{$PORT:80} {
	log {
		format json
	}

	# Appen har EN adress: www.runquest.dev. API:ets CORS tillåter bara den, och inloggningen
	# (localStorage) är per adress — därför skickas apex-domänen vidare i stället för att servera appen.
	@apex host runquest.dev
	redir @apex https://www.runquest.dev{uri} 308

	# Egen handle: ett toppnivå-respond sorteras efter handle och skulle skuggas av SPA-blocket.
	handle /health {
		respond 200
	}

	header {
		X-Content-Type-Options "nosniff"
		-Server
	}

	root * {{.DIST_DIR}}

	encode {
		gzip
		zstd
	}

	# Källkartor (.map) är till för Sentry och serveras aldrig, på någon sökväg (RUN-285). Bygget tar bort dem ur dist; den här regeln gör att
	# en som ändå råkar ligga kvar inte nås, och att en förfrågan utanför /assets (t.ex. /foo.js.map) får 404 i stället för index.html via SPA-fallbacken.
	# Först av handle-blocken, så den gäller före /assets-blocket.
	@sourcemap path *.map
	handle @sourcemap {
		header Cache-Control "no-store"
		respond "Not found" 404
	}

	# Vite-hashade filer byter namn vid varje bygge och får cachas för alltid.
	# Cache-headern sätts bara på filer som finns: en cachad 404 skulle överleva nästa deploy.
	handle /assets/* {
		@exists {
			file
			not path */
		}
		header @exists Cache-Control "public, max-age=31536000, immutable"
		@missing not {
			file
			not path */
		}
		header @missing Cache-Control "no-store"
		respond @missing "Not found" 404
		file_server
	}

	# Filmens mediefiler: namnet bär versionen (.v1), så en ändrad fil får ett nytt namn och cachen kan vara för alltid. Samma mönster som /assets.
	handle /media/* {
		@exists {
			file
			not path */
		}
		header @exists Cache-Control "public, max-age=31536000, immutable"
		@missing not {
			file
			not path */
		}
		header @missing Cache-Control "no-store"
		respond @missing "Not found" 404
		file_server
	}

	# Självhostade typsnitt (OFL, se public/fonts/OFL.txt): namnet bär versionen (bebas-neue-400.v1.woff2), så filerna cachas för alltid. Saknade filer ger 404, aldrig index.html (HTML som typsnitt = tyst reservtypsnitt).
	# Typen sätts explicit eftersom typtabellen i prodcontainern är okänd; file_server skriver bara över Content-Type när den saknas. Ingen CSP begränsar font-src.
	handle /fonts/* {
		@exists {
			file
			not path */
		}
		header @exists Cache-Control "public, max-age=31536000, immutable"
		@woff2 {
			file
			path *.woff2
		}
		header @woff2 Content-Type "font/woff2"
		@missing not {
			file
			not path */
		}
		header @missing Cache-Control "no-store"
		respond @missing "Not found" 404
		file_server
	}

	# Go och Caddy saknar .webmanifest i sin inbyggda typtabell, och typtabellen i prodcontainern är okänd: typen sätts explicit.
	# file_server skriver bara över Content-Type när den saknas, så den här gäller. Bara om filen finns: en saknad manifestfil faller tillbaka på index.html och ska inte få manifesttypen.
	@webmanifest {
		path /site.webmanifest
		file
	}
	header @webmanifest Content-Type "application/manifest+json"

	handle {
		header Cache-Control "no-cache"
		try_files {path} {path}.html {path}/index.html /index.html
		file_server {
			hide .git
			hide .env*
		}
	}
}
