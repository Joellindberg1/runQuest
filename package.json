{
  "name": "runquest",
  "version": "0.8.0",
  "description": "RunQuest - Löparapp med gamification",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "start": "npm run start --workspace=@runquest/backend",
    "dev:frontend": "npm run dev --workspace=@runquest/frontend",
    "dev:backend": "npm run dev --workspace=@runquest/backend",
    "build": "npm run build --workspaces --if-present",
    "build:frontend": "npm run build --workspace=@runquest/frontend",
    "build:backend": "npm run build --workspace=@runquest/backend",
    "lint": "npm run lint --workspaces --if-present",
    "type-check": "npm run type-check --workspaces --if-present",
    "loadtest:staging": "node scripts/loadtest/run.mjs",
    "loadtest:cleanup": "node scripts/loadtest/run.mjs --cleanup",
    "loadtest:local": "node scripts/loadtest/local.mjs",
    "clean": "rm -rf node_modules apps/*/node_modules packages/*/node_modules apps/*/dist"
  },
  "devDependencies": {
    "@types/node": "^20.5.9",
    "rollup": "4.64.2",
    "typescript": "^5.2.2"
  },
  "engines": {
    "node": ">=20.19.0",
    "npm": ">=9.0.0"
  },
  "overrides": {
    "rollup": "$rollup"
  }
}
