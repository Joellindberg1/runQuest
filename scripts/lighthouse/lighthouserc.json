{
  "ci": {
    "collect": {
      "url": ["http://127.0.0.1:18090/", "http://127.0.0.1:18090/legal"],
      "numberOfRuns": 3,
      "settings": {
        "chromeFlags": "--headless=new --no-sandbox --disable-gpu --disable-background-networking --disable-component-update --disable-sync --no-first-run"
      }
    },
    "assert": {
      "assertMatrix": [
        {
          "matchingUrlPattern": "^http://127\\.0\\.0\\.1:18090/$",
          "aggregationMethod": "median",
          "assertions": {
            "categories:performance": ["error", { "minScore": 0.9 }],
            "categories:accessibility": ["error", { "minScore": 0.95 }],
            "categories:best-practices": ["error", { "minScore": 0.9 }],
            "categories:seo": ["error", { "minScore": 0.95 }],
            "largest-contentful-paint": ["error", { "maxNumericValue": 2500 }],
            "first-contentful-paint": ["error", { "maxNumericValue": 1950 }],
            "cumulative-layout-shift": ["error", { "maxNumericValue": 0.02 }],
            "total-blocking-time": ["error", { "maxNumericValue": 150 }],
            "resource-summary:script:size": ["error", { "maxNumericValue": 150000 }],
            "resource-summary:stylesheet:size": ["error", { "maxNumericValue": 30000 }],
            "resource-summary:total:size": ["error", { "maxNumericValue": 355000 }]
          }
        },
        {
          "matchingUrlPattern": "^http://127\\.0\\.0\\.1:18090/legal$",
          "aggregationMethod": "median",
          "assertions": {
            "categories:performance": ["error", { "minScore": 0.75 }],
            "categories:accessibility": ["error", { "minScore": 0.95 }],
            "categories:best-practices": ["error", { "minScore": 0.9 }],
            "categories:seo": ["error", { "minScore": 0.95 }],
            "largest-contentful-paint": ["error", { "maxNumericValue": 3600 }],
            "cumulative-layout-shift": ["error", { "maxNumericValue": 0.05 }],
            "total-blocking-time": ["error", { "maxNumericValue": 200 }],
            "resource-summary:script:size": ["error", { "maxNumericValue": 275000 }],
            "resource-summary:stylesheet:size": ["error", { "maxNumericValue": 50000 }],
            "resource-summary:total:size": ["error", { "maxNumericValue": 500000 }]
          }
        }
      ]
    }
  }
}
