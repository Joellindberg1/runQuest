# Kopiera till .env och fyll i. Alla VITE_-variabler bakas in i bygget (publika).

# Backend-API:t (lokal dev: backend kör på port 3001)
VITE_API_URL=http://localhost:3001/api

# Supabase – URL + publishable key (sb_publishable_..., publik per design)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key-here
