# Kopiera till .env och fyll i. Alla VITE_-variabler bakas in i bygget (publika).

# Backend-API:t (lokal dev: backend kör på port 3001)
# Frontend pratar bara med backenden — ingen Supabase-klient, inga Supabase-nycklar i klienten.
VITE_API_URL=http://localhost:3001/api

# Felspårning (Sentry, projektet runquest-frontend). Utan DSN är spårningen helt av och ingen Sentry-kod hämtas. Lämna tom lokalt.
VITE_SENTRY_DSN=
# Miljötagg i Sentry (t.ex. staging, production). Utelämnad: byggläget.
VITE_SENTRY_ENVIRONMENT=
# Prestandamätning (Web Vitals, docs/performance.md): andelen sidladdningar som mäts. Standard och tak 0.1; kan bara sänka, 0 = av.
# Värdet bakas in vid bygget.
# VITE_SENTRY_TRACES_SAMPLE_RATE=
# Källkartor laddas upp av bygget med SENTRY_AUTH_TOKEN (byggvariabel på Railway, aldrig här). Releasen bakas in som VITE_SENTRY_RELEASE av vite.config.ts; sätt den inte själv.

# Webbanalys (Umami Cloud, docs/release.md). Webbplatsens id, inte hemligt. Sätts bara på prodtjänsten; lämna tom lokalt och i staging: tom = inget skript laddas.
VITE_UMAMI_WEBSITE_ID=
