# Backend Environment Variables
# Copy this file to .env and fill in your actual values

# Node Environment
NODE_ENV=development
PORT=3001
# Sätt aldrig TZ på backendtjänsten: processen ska köra i UTC (docs/release.md). Stockholm-jobben får sin zon av schemana själva.

# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# JWT Configuration  
JWT_SECRET=your-jwt-secret-here
JWT_EXPIRES_IN=7d

# Strava API Configuration
STRAVA_CLIENT_ID=your-strava-client-id
STRAVA_CLIENT_SECRET=your-strava-client-secret

# Strava webhooks (ADR 010). Utan dem startar appen, men GET /api/strava/webhook svarar 503 och POST kastar händelsen.
# Verify-token: hemlig slumpsträng, minst 32 tecken. Subscription-id: det id Strava ger när prenumerationen skapats (inte hemligt).
STRAVA_WEBHOOK_VERIFY_TOKEN=your-random-verify-token-at-least-32-chars
STRAVA_WEBHOOK_SUBSCRIPTION_ID=

# Kryptering av Strava-tokens (ADR 013, docs/runbook-token-key.md). Båda variablerna lämnas TOMMA här: ett riktigt värde hör aldrig hemma
# i repot, i en chatt eller i en lokal .env (railway run ger skript tjänstens miljö). Ägaren sätter värdet i Railway-UI:t.
#   TOKEN_ENCRYPTION_KEY=<kid>:<base64 av exakt 32 byte>   aktiva nyckeln. <kid> = prod-1, prod-2 ... (staging: stg-1). Utan en giltig nyckel
#                                                          är Strava-synken avstängd (KRITISKT-larm vid start), resten av appen går.
#   TOKEN_ENCRYPTION_KEYS_RETIRED=<kid>:<base64>[,...]     valfri: pensionerade nycklar, bara för dekryptering, under en rotation.
# Skapa ett värde lokalt (skrivs bara ut i din egen terminal):
#   node -e "console.log('prod-1:' + require('crypto').randomBytes(32).toString('base64'))"
# I produktion godtas bara kid som börjar på prod- (stg- när SENTRY_ENVIRONMENT=staging); testnyckeln test-1 avvisas.
TOKEN_ENCRYPTION_KEY=
TOKEN_ENCRYPTION_KEYS_RETIRED=

# CORS — allowed origins (comma-separated). Production: https://www.runquest.dev
# Vite-devservern kör på port 8080 (apps/frontend/vite.config.ts)
CORS_ORIGIN=http://localhost:8080

# Sentry (felrapportering). Utan SENTRY_DSN skickas ingenting (dev, tester, CI). DSN:en hårdkodas aldrig.
# SENTRY_ENVIRONMENT: production i produktion, staging i staging. npm run sentry:test skickar en testhändelse.
SENTRY_DSN=
SENTRY_ENVIRONMENT=
# Prestandaspårning (docs/performance.md): andelen förfrågningar som mäts. Standard och tak 0.1; kan bara sänka, 0 = av.
# SENTRY_TRACES_SAMPLE_RATE=
# Källkartor (bygget): SENTRY_AUTH_TOKEN laddar upp kartorna till Sentry vid 'npm run build'. Sätts bara som byggvariabel på Railway,
# aldrig här lokalt. Utan den hoppas uppladdningen över och bygget går igenom. Se docs/release.md ('Källkartor till Sentry').
# SENTRY_AUTH_TOKEN=
